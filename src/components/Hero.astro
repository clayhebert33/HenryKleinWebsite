---
---
<section class="min-h-screen flex items-center pt-20 pb-16 px-6">
  <div class="max-w-6xl mx-auto w-full">
    <div class="flex flex-col-reverse md:flex-row items-center gap-12 md:gap-16">

      <!-- Text -->
      <div class="flex-1 text-center md:text-left">
        <p class="text-sage font-medium tracking-widest text-sm uppercase mb-4">
          Doctor of Physical Therapy · Austin, TX
        </p>
        <h1
          class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6 text-charcoal"
          style="font-family: 'Playfair Display', serif;"
        >
          Move better, recover stronger, and get back to doing what you love.
        </h1>
        <p class="text-lg text-charcoal-light leading-relaxed mb-8 max-w-xl mx-auto md:mx-0">
          Henry Klein is an Austin-based Doctor of Physical Therapy and a fellow athlete that can help you get back in the game.
        </p>
        <a
          href="#contact"
          class="inline-block bg-terracotta hover:bg-terracotta-dark text-white font-semibold px-8 py-4 rounded-full transition-colors duration-200 shadow-sm hover:shadow-md text-sm tracking-wide"
        >
          Get in Touch
        </a>
      </div>

      <!-- Image -->
      <div class="flex-shrink-0">
        <img
          src="/images/henry-klein.jpg"
          alt="Henry Klein, DPT — Austin Physical Therapist"
          class="rounded-2xl shadow-xl object-cover w-72 sm:w-80 md:w-auto"
          style="width: 500px; max-width: 100%;"
        />
      </div>

    </div>
  </div>
</section>
