---
---
<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a
      href="#"
      class="text-charcoal hover:text-sage transition-colors duration-200"
      style="font-family: 'Playfair Display', serif; font-size: 1.125rem; font-weight: 600; letter-spacing: -0.01em;"
    >
      Henry Klein, DPT
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-8">
      {[
        { href: '#about', label: 'About' },
        { href: '#specialties', label: 'Specialties' },
        { href: '#services', label: 'Services' },
        { href: '#testimonials', label: 'Testimonials' },
        { href: '#contact', label: 'Contact' },
      ].map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="text-sm font-medium text-charcoal-light hover:text-sage transition-colors duration-200 tracking-wide"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile hamburger -->
    <button
      id="menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-2 -mr-2 rounded-md focus:outline-none"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <span class="hamburger-bar block w-5 h-0.5 bg-charcoal transition-all duration-300"></span>
      <span class="hamburger-bar block w-5 h-0.5 bg-charcoal transition-all duration-300"></span>
      <span class="hamburger-bar block w-5 h-0.5 bg-charcoal transition-all duration-300"></span>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden px-6 pb-6 pt-2"
  >
    <ul class="flex flex-col gap-4">
      {[
        { href: '#about', label: 'About' },
        { href: '#specialties', label: 'Specialties' },
        { href: '#services', label: 'Services' },
        { href: '#testimonials', label: 'Testimonials' },
        { href: '#contact', label: 'Contact' },
      ].map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="mobile-link block text-base font-medium text-charcoal-light hover:text-sage transition-colors duration-200"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const menuBtn = document.getElementById('menu-btn')!;
  const mobileMenu = document.getElementById('mobile-menu')!;
  const mobileLinks = document.querySelectorAll('.mobile-link');

  // Scroll: add background blur
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      header.classList.add('bg-cream/90', 'backdrop-blur-md', 'shadow-sm');
    } else {
      header.classList.remove('bg-cream/90', 'backdrop-blur-md', 'shadow-sm');
    }
  });

  // Hamburger toggle
  menuBtn.addEventListener('click', () => {
    const isOpen = !mobileMenu.classList.contains('hidden');
    mobileMenu.classList.toggle('hidden');
    menuBtn.setAttribute('aria-expanded', String(!isOpen));
  });

  // Close on link click
  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      menuBtn.setAttribute('aria-expanded', 'false');
    });
  });
</script>
