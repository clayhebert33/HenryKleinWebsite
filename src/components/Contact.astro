---
// TODO: Replace placeholder address
---
<section id="contact" class="py-24 px-6 bg-charcoal">
  <div class="max-w-4xl mx-auto">
    <h2
      class="text-3xl sm:text-4xl font-bold text-cream mb-4"
      style="font-family: 'Playfair Display', serif;"
    >
      Work With Henry
    </h2>
    <p class="text-cream/70 text-lg mb-12 max-w-xl">
      Ready to move better? Reach out to schedule a consultation or ask a question.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <!-- Form -->
      <form
        id="contact-form"
        class="flex flex-col gap-5"
        action="https://formspree.io/f/mljewqer"
        method="POST"
      >
        <div class="flex flex-col gap-1.5">
          <label for="name" class="text-sm font-medium text-cream/80">Name</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            placeholder="Your name"
            class="bg-white/10 border border-white/20 rounded-lg px-4 py-3 text-cream placeholder:text-cream/40 focus:outline-none focus:border-sage focus:ring-1 focus:ring-sage transition-colors"
          />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="email" class="text-sm font-medium text-cream/80">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            placeholder="your@email.com"
            class="bg-white/10 border border-white/20 rounded-lg px-4 py-3 text-cream placeholder:text-cream/40 focus:outline-none focus:border-sage focus:ring-1 focus:ring-sage transition-colors"
          />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="message" class="text-sm font-medium text-cream/80">Message</label>
          <textarea
            id="message"
            name="message"
            required
            rows="5"
            placeholder="Tell Henry what you're dealing with..."
            class="bg-white/10 border border-white/20 rounded-lg px-4 py-3 text-cream placeholder:text-cream/40 focus:outline-none focus:border-sage focus:ring-1 focus:ring-sage transition-colors resize-none"
          ></textarea>
        </div>
        <button
          type="submit"
          class="bg-terracotta hover:bg-terracotta-dark text-white font-semibold px-8 py-4 rounded-full transition-colors duration-200 shadow-sm text-sm tracking-wide w-fit disabled:opacity-60 disabled:cursor-not-allowed"
        >
          Send Message
        </button>
        <p id="contact-form-status" class="text-sm hidden" role="status" aria-live="polite"></p>
      </form>

      <script>
        const form = document.getElementById('contact-form') as HTMLFormElement | null;
        const status = document.getElementById('contact-form-status');

        form?.addEventListener('submit', async (event) => {
          event.preventDefault();
          if (!status) return;

          const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
          if (submitButton) submitButton.disabled = true;

          status.classList.remove('hidden', 'text-red-400', 'text-sage-light');
          status.textContent = 'Sending...';

          try {
            const response = await fetch(form.action, {
              method: 'POST',
              body: new FormData(form),
              headers: { Accept: 'application/json' },
            });

            if (response.ok) {
              status.textContent = "Thanks! Your message has been sent — Henry will get back to you soon.";
              status.classList.add('text-sage-light');
              form.reset();
            } else {
              status.textContent = 'Something went wrong sending your message. Please try again or call instead.';
              status.classList.add('text-red-400');
            }
          } catch {
            status.textContent = 'Something went wrong sending your message. Please try again or call instead.';
            status.classList.add('text-red-400');
          } finally {
            if (submitButton) submitButton.disabled = false;
          }
        });
      </script>

      <!-- Info -->
      <div class="flex flex-col gap-8 justify-center">
        <div>
          <p class="text-cream/50 text-xs font-medium uppercase tracking-widest mb-2">Phone</p>
          <p class="text-cream text-lg">(512) 994-0579 (ask for Henry)</p>
        </div>
        <div>
          <p class="text-cream/50 text-xs font-medium uppercase tracking-widest mb-2">Location</p>
          <p class="text-cream text-lg leading-relaxed">
            Austin Athletic Performance and Recovery<br />
            2119 Frate Barker Rd Unit 1102<br />Austin, TX 78748
          </p>
          <a
            href="https://maps.app.goo.gl/7rxX7StTDhep4Rmb7"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block mt-2 text-sage-light hover:text-sage text-sm underline underline-offset-2 transition-colors duration-200"
          >
            View on Google Maps
          </a>
        </div>
        <div>
          <p class="text-cream/50 text-xs font-medium uppercase tracking-widest mb-2">Response Time</p>
          <p class="text-cream/80 text-base">Henry typically responds within one business day.</p>
        </div>
      </div>
    </div>
  </div>
</section>
