---
// TODO: Replace with real testimonials and real headshot images in public/images/
const testimonials = [
  {
    headline: 'Pain-free after a year of knee trouble.',
    quote: "I'd been dealing with knee pain for over a year before I found Henry. Within six weeks of working with him, I ran my first half marathon pain-free. He actually listened, explained everything, and made me feel like a person — not just a patient.",
    name: 'Sarah Mitchell',
    condition: 'Running Injury / IT Band Syndrome',
    photo: '/images/testimonial-sarah.jpg',
    initials: 'SM',
  },
  {
    headline: 'Back on the court better than before.',
    quote: "After my ACL surgery, I was nervous about getting back on the court. Henry's rehab program was thorough, smart, and progressive — he never rushed me, but he pushed me exactly when I needed it. I'm back playing tennis at a higher level than before my injury.",
    name: 'James Torres',
    condition: 'ACL Rehab & Return to Sport',
    photo: '/images/testimonial-james.jpg',
    initials: 'JT',
  },
  {
    headline: "Expertise and warmth you won't find anywhere else.",
    quote: "Henry is the rare kind of PT who combines real expertise with genuine warmth. He treated my shoulder labral tear with a level of care and technical precision that I haven't found anywhere else in Austin. Highly recommend.",
    name: 'Dana Reeves',
    condition: 'Shoulder Labral Repair',
    photo: '/images/testimonial-dana.jpg',
    initials: 'DR',
  },
];
---
<section id="testimonials" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">
    <h2
      class="text-3xl sm:text-4xl font-bold text-charcoal mb-4"
      style="font-family: 'Playfair Display', serif;"
    >
      What Patients Say
    </h2>
    <p class="text-charcoal-light text-lg mb-12 max-w-2xl">
      Real people, real results. Here's what a few of Henry's patients have to say.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {testimonials.map(({ headline, quote, name, condition, photo, initials }) => (
        <div class="bg-mist rounded-2xl p-8 flex flex-col gap-4">
          <span class="text-4xl text-sage-light leading-none" aria-hidden="true">&ldquo;</span>
          <p class="font-semibold text-charcoal text-base leading-snug">{headline}</p>
          <p class="text-charcoal-light leading-relaxed text-base italic flex-1">
            {quote}
          </p>
          <div class="border-t border-sage-light/40 pt-5 flex items-center justify-between gap-4">
            <div>
              <p class="font-semibold text-charcoal text-sm">{name}</p>
              <p class="text-stone text-xs mt-0.5">{condition}</p>
            </div>
            <div
              class="w-12 h-12 rounded-full bg-sage-light flex items-center justify-center flex-shrink-0 overflow-hidden"
              aria-hidden="true"
            >
              <img
                src={photo}
                alt={name}
                class="w-full h-full object-cover"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              <span
                class="text-white text-sm font-semibold hidden w-full h-full items-center justify-center"
                style="display:none;"
              >
                {initials}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
